# LLM service
OPENAI_API_BASE=https://your-openai-compatible-api-base-url
OPENAI_API_KEY=your-api-key-here
EMBEDDING_API_URL=https://your-embedding-api-url

# DB
APP_ENV=local
DB_URL=postgresql+psycopg://user:password@localhost:5434/georag_dev

# Java-issued JWT verification (public key only)
# Relative paths are resolved from the project root.
JWT_PUBLIC_KEY_PATH=.secrets/jwt/public.pem

# Vector database config
# true=pgvector, false=chromadb
USE_PGVECTOR=true
DEFAULT_EMBEDDING_MODEL=text-embedding-v4
VECTOR_DIMENSION=1536

# MCP server configuration (JSON string)
# Each key is a server name. Each value must contain:
#   - "url"       : the MCP server endpoint (for streamable_http transport)
#   - "transport" : "streamable_http" or "stdio"
#
# To add more servers, extend the JSON object:
#   MCP_CONFIG={"server1": {...}, "server2": {...}}
MCP_CONFIG={"pygeomodels": {"url": "http://localhost:8050/mcp", "transport": "streamable_http"}}

# Chat/MCP observability
LOG_TO_FILE=true
LOG_LEVEL=INFO
LOG_DIR=logs
MCP_AGENT_TIMEOUT_SECONDS=300
